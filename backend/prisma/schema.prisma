// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model ChatHistory {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  user_id    String
  session_id String
  sender     String
  message    String
  created_at DateTime

  @@map("chat_history")
}

model UserProfile {
  id                          String    @id @default(auto()) @map("_id") @db.ObjectId
  user_id                     String    @unique
  email                       String?
  display_name                String?
  role_context                String?
  aspirations                 String?
  strengths                   String?
  weaknesses                  String?
  values_list                 String[]
  active_focus                String?
  notes                       String?
  long_term_summary           String?
  long_term_summary_at        DateTime?
  long_term_summary_msg_count Int?
  created_at                  DateTime?
  updated_at                  DateTime?

  @@map("user_profiles")
}

model Profile {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  user_id    String
  title      String
  context    String?
  confidence Int
  is_primary Boolean  @default(false)
  source     String // "agent" | "user" | "promoted"
  created_at DateTime
  updated_at DateTime
  share_token String? // random public token; null when not shared
  is_public   Boolean @default(false)

  @@index([user_id])
  @@index([user_id, is_primary])
  @@unique([user_id, title])
  @@index([share_token])
  @@map("profiles")
}

type PortfolioLink {
  label String
  url   String
}

model PortfolioItem {
  id           String          @id @default(auto()) @map("_id") @db.ObjectId
  user_id      String
  title        String
  description  String?
  contribution String?
  links        PortfolioLink[]
  profile_ids  String[]
  created_at   DateTime
  updated_at   DateTime

  @@index([user_id])
  @@index([profile_ids])
  @@map("portfolio_items")
}
