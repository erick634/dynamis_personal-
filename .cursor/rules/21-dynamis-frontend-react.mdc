├── hooks/                        # cross-feature hooks
├── stores/                       # Zustand stores
├── lib/
│   ├── livekit.ts                # LiveKit room/connection helpers
│   ├── api.ts                    # TanStack Query setup, REST client
│   └── i18n.ts                   # react-i18next setup
├── services/                     # backend API clients (per `01-file-organization`)
