# ============================================================================
# Dynamis Frontend — environment template
# Copy to .env and adjust for your setup:  cp .env.example .env
# ============================================================================

# Backend voice service URL (HTTP base)
VITE_API_BASE_URL=http://localhost:8000

# WebSocket host — the app appends /voice/realtime (see src/lib/config.ts)
VITE_WS_BASE_URL=ws://localhost:8000

# WebSocket JWT for /voice/realtime. Leave empty for local dev with
# DEV_AUTH_BYPASS=true on the backend. In production, use a real WorkOS token.
VITE_DYNAMIS_JWT=

# When true, Live connects without a JWT. Use only with local backend
# running DEV_AUTH_BYPASS=true.
VITE_ALLOW_EMPTY_TOKEN=false

# ============================================================================
# Production (Cloud Run) example:
# VITE_API_BASE_URL=https://dynamis-backend-33565254033.us-central1.run.app
# VITE_WS_BASE_URL=wss://dynamis-backend-33565254033.us-central1.run.app
# VITE_ALLOW_EMPTY_TOKEN=false
# VITE_DYNAMIS_JWT=<WorkOS JWT>
# ============================================================================
