# ============================================================================
# Default: backend local com bypass de auth (DEV_AUTH_BYPASS=true).
#   1) cd backendend && npm install && npm run dev
#   2) npm run dev neste projeto
# ============================================================================
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000

# Quando true, a Live conecta no WebSocket mesmo sem JWT.
# Só use junto com backend local rodando DEV_AUTH_BYPASS=true.
VITE_ALLOW_EMPTY_TOKEN=true

# JWT do WebSocket /voice/realtime. Cole aqui um token WorkOS válido se for
# falar com o backend de produção (Cloud Run). Em dev local pode deixar vazio.
VITE_DYNAMIS_JWT=

# ============================================================================
# Para apontar para o backend de produção (app-live-kit/.env equivalente):
# VITE_API_BASE_URL=https://dynamis-backend-33565254033.us-central1.run.app
# VITE_WS_BASE_URL=wss://dynamis-backend-33565254033.us-central1.run.app
# VITE_ALLOW_EMPTY_TOKEN=false
# VITE_DYNAMIS_JWT=<JWT do WorkOS>
# ============================================================================
